{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Agent": {
    "IncidentAnalysis": {
      "Provider": "OpenAI-compatible provider",
      "Model": "nex-agi/nex-n2-pro:free",
      "Endpoint": "https://openrouter.ai/api/v1",
      "ApiKey": "",
      "AnalysisTimeoutSeconds": 45,
      "MaxOutputTokens": 1200,
      "Temperature": 0.1
    }
  },
  "Runbooks": {
    "SemanticRetrieval": {
      "VectorStoreProvider": "SQLite",
      "DatabasePath": "",
      "KnowledgeBasePath": "",
      "QdrantEndpoint": "http://localhost:6333",
      "QdrantCollectionName": "incident_runbook_chunks",
      "QdrantApiKey": "",
      "QdrantTimeoutSeconds": 5,
      "Endpoint": "https://api-inference.huggingface.co/pipeline/feature-extraction/",
      "Model": "thenlper/gte-large",
      "ApiKey": "",
      "LocalEmbeddingModel": "local-hashing-384",
      "LocalEmbeddingDimensions": 384,
      "MaxResults": 3,
      "MinimumRelevanceScore": 0.25,
      "SemanticWeight": 0.75,
      "LexicalWeight": 0.25
    }
  },
  "Tools": {
    "OperationalData": {
      "LogEntriesPath": "",
      "MetricSamplesPath": "",
      "HighErrorRateThreshold": 25,
      "CriticalErrorRateThreshold": 40,
      "QueueDepthWarningThreshold": 700,
      "MaxDetectedIncidents": 10,
      "UseDeterministicFallbacks": false
    }
  },
  "Storage": {
    "Incidents": {
      "SessionDatabasePath": "",
      "IncidentRecordsPath": ""
    }
  }
}
